# Copy this file to `.env` and fill in values if you choose to use the Kaggle
# API for automated downloads. The project does NOT require these: the dataset
# can be downloaded manually (see data/README.md). Never commit a real .env.

# Kaggle API credentials (optional). Obtain from https://www.kaggle.com -> Account -> Create New API Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
