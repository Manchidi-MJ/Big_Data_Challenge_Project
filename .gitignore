# ---- Data (never commit raw or large processed data) ----
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ---- Model artifacts (can be regenerated) ----
outputs/models/*.joblib
outputs/models/*.pkl

# ---- Secrets ----
.env
*.env
kaggle.json
**/.kaggle/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---- Spark / Hadoop on Windows ----
spark-warehouse/
metastore_db/
derby.log

# ---- Virtual envs ----
.venv/
venv/
env/

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
